<nav class="bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <%= link_to "Event Karo",
          root_path,
          class: "text-3xl font-bold tracking-tight" %>

      <div class="flex items-center gap-4">

        <% if user_signed_in? %>

          <div class="relative group">
            <button class="flex items-center gap-2 rounded-lg border border-gray-300 px-4 py-2 hover:bg-gray-100 transition">
              <span class="font-medium"><%= current_user.name %></span>

              <svg xmlns="http://www.w3.org/2000/svg"
                   class="h-4 w-4 transition group-hover:rotate-180"
                   fill="none"
                   viewBox="0 0 24 24"
                   stroke="currentColor">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Dropdown -->
            <div class="absolute right-0 top-full hidden w-52 rounded-xl border border-gray-200 bg-white shadow-lg group-hover:block z-50">
              <div class="border-b border-gray-100 px-4 py-3">
                <p class="font-semibold"><%= current_user.name %></p>
                <p class="text-sm text-gray-500"><%= current_user.email %></p>
              </div>

              <%= link_to " Edit Profile",
                  edit_user_registration_path,
                  class: "block px-4 py-3 hover:bg-gray-100 transition" %>

              <%= link_to " My Events",
                  "#",
                  class: "block px-4 py-3 hover:bg-gray-100 transition" %>

              <div class="border-t border-gray-100">
                <%= link_to " Log Out",
                    destroy_user_session_path,
                    data: { turbo_method: :delete },
                    class: "block px-4 py-3 text-red-600 hover:bg-red-50 transition" %>
              </div>

            </div>
          </div>

        <% else %>

          <%= link_to "Log in",
              new_user_session_path,
              class: "rounded-lg border border-black px-5 py-2 hover:bg-black hover:text-white transition" %>

        <% end %>

      </div>
    </div>
  </div>
</nav>