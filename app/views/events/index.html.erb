<p style="color: green"><%= notice %></p>

<% content_for :title, "Events" %>



<div id="events" >
    <h2 class="font-extrabold text-3xl py-4">Upcoming Events</h2>
    <div class ="flex  ">
        <% @upcoming_events.each do |event| %>
          <div class = "basis-lg">
          <%= render event %>
            <p>
            <%= link_to "Show this event", event %>
            </p>
          </div>
        <% end %>
    </div>
</div>
<br>
<%= link_to "New event", new_event_path ,class:"bg-blue-500 hover:bg-blue-400 text-white font-bold py-2 px-4 border-b-4 border-blue-700 hover:border-blue-500 rounded" %>

<br><br>
<div id="events">
    <h2 class="font-extrabold text-3xl ">Past Events</h2>
    <div class ="flex  ">
  <% @past_events.each do |event| %>
    <div class = "basis-lg">
    <%= render event %>
    <p>
      <%= link_to "Show this event", event %>
    </p>
    </div>
  <% end %>
  </div>
</div>